OBLAK_DATABASE_PATH=oblak_cloud.sqlite3
OBLAK_AUDIT_LOG_PATH=oblak-cloud-audit.log
OBLAK_PUBLIC_BASE_URL=http://localhost:8000
OBLAK_BIND_HOST=127.0.0.1
OBLAK_BIND_PORT=8000
OBLAK_BOOTSTRAP_USERNAME=alice
OBLAK_BOOTSTRAP_TOKEN=replace-with-local-token
OBLAK_RUN_FRESHCLAM_ON_STARTUP=false
GEMINI_API_KEY=replace-with-local-secret
OBLAK_RUNTIME_BACKEND=disabled
OBLAK_FIRECRACKER_DRY_RUN=false
OBLAK_FIRECRACKER_BIN=firecracker
OBLAK_FIRECRACKER_KERNEL=/var/lib/oblak/firecracker/vmlinux
OBLAK_FIRECRACKER_ROOTFS=/var/lib/oblak/firecracker/rootfs.ext4
OBLAK_FIRECRACKER_WORK_DIR=/data/firecracker-runs
OBLAK_FIRECRACKER_AUDIT_LOG_PATH=/data/firecracker-audit.jsonl
OBLAK_FIRECRACKER_TIMEOUT_SECONDS=10
OBLAK_FIRECRACKER_MEMORY_MIB=128
